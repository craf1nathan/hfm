# ── Cell 1: Imports & paths ──────────────────────────────────────────────────
import sys
sys.path.append("..")                      # reach src/ from notebooks/

from src.phase1_data_pipeline import run_pipeline, load_configs
import pandas as pd

# ── Cell 2: Run pipeline ─────────────────────────────────────────────────────
splits, master, reports = run_pipeline(
    data_cfg_path     = "../config/data_config.json",
    pipeline_cfg_path = "../config/pipeline_config.json",
    verbose           = True
)

# ── Cell 3: Inspect master ───────────────────────────────────────────────────
master.info()
master.head(3)

# ── Cell 4: Check splits ─────────────────────────────────────────────────────
for name, df in splits.items():
    print(f"{name:>12}: {len(df):>8,} bars  {df.index[0]} → {df.index[-1]}")

# ── Cell 5: Cleaning report ──────────────────────────────────────────────────
pd.DataFrame(reports).T

# ── Cell 6: Session distribution per split ───────────────────────────────────
for name, df in splits.items():
    print(f"\n── {name} ──")
    print(df["session"].value_counts().sort_index())

# ── Cell 7: NaN audit (session breaks & unfilled gaps) ───────────────────────
nan_audit = master.isna().sum()
nan_audit = nan_audit[nan_audit > 0]
print("Columns with NaN (session breaks / unfilled gaps):")
print(nan_audit)

# ── Cell 8: Fill flag audit ───────────────────────────────────────────────────
fill_cols = [c for c in master.columns if c.endswith("_is_filled")]
print("Forward-filled bars per predictor:")
print(master[fill_cols].sum().to_string())

# ── Cell 9: Quick sanity plot (target close) ─────────────────────────────────
import matplotlib.pyplot as plt

fig, ax = plt.subplots(figsize=(14, 3))
master["close"].plot(ax=ax, lw=0.5, color="steelblue")
for name, df in splits.items():
    ax.axvspan(df.index[0], df.index[-1],
               alpha=0.08,
               label=name,
               color={"train": "green", "validation": "orange", "test": "red"}[name])
ax.legend()
ax.set_title("Target Close — Split Regions")
plt.tight_layout()
plt.show()
